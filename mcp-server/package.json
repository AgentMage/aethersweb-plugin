{
  "name": "aethersweb-mcp-server",
  "version": "0.1.0",
  "description": "MCP server exposing AethersWeb spaces/logs/contexts to an MCP client. Runs outside the vault as its own process — see ../CLAUDE.md and ../Spec.md (in the deployed vault).",
  "main": "dist/server.js",
  "private": true,
  "type": "module",
  "bin": {
    "aethersweb-mcp-server": "dist/server.js"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "diff": "^9.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^20.14.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.5.3",
    "vitest": "^2.1.4"
  }
}
