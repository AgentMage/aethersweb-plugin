{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["DOM", "ES6", "ES2018", "ES2020", "ES2021"],
    "types": ["node"],
    "strict": true,
    "noImplicitAny": true,
    "importHelpers": true,
    "isolatedModules": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "allowJs": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
